# ============================================================
# PHISHLENS ENVIRONMENT CONFIGURATION
# ============================================================

# Database
# Leave this unset to use the application's default SQLite database.
PHISHLENS_DATABASE_URL=sqlite:///instance/phishlens.db

# Optional external threat intelligence
GOOGLE_SAFE_BROWSING_KEY=
PHISHTANK_APP_KEY=

# Flask
FLASK_DEBUG=true