{
  "id": "/",
  "name": "PhishLens — Threat Intelligence",
  "short_name": "PhishLens",
  "description": "Inspect suspicious links, QR destinations, and payment requests.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "background_color": "#0b0c10",
  "theme_color": "#0b0c10",
  "icons": [
    {
      "src": "/static/phishlens-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
